{
  "name": "bilibili-multi-account",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:readme",
    "build:readme": "node scripts/build-readme.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run lint && npm run build && npm test",
    "lint": "eslint src scripts tests eslint.config.js",
    "format": "prettier --write src scripts tests *.js *.json *.md"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1"
  }
}
